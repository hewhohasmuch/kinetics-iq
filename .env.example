# Supabase project credentials — copy to .env.local and fill in.
# Found under Project Settings → API in the Supabase dashboard.
#
# The anon key is safe to expose in client code: row-level security
# (see supabase/schema.sql) restricts every query to the signed-in
# clinician's own rows.
#
# If these are unset the app runs in local-only mode: no login, no sync,
# everything stays in localStorage (the pre-accounts behavior).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
